# Puerto local
PORT=5173

# Opciones: mock | openai-compatible | generic-rest | gemini | groq | openai
AI_PROVIDER=mock

# --- Proveedores gratuitos ---
# Estos se pueden seleccionar desde el frontend y enviar la API Key en cada request.
# También se pueden configurar como variables de entorno para el backend standalone:

# Google Gemini (gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (gratuito, rápido): https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (crédito gratis): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek (China, muy económico): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Moonshot / Kimi (China): https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# --- Proveedores configurables manualmente ---

# Para proveedores compatibles con /chat/completions
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=tu_api_key
OPENAI_COMPATIBLE_MODEL=tu_modelo

# Para un endpoint REST propio que devuelva { "translation": "..." }
GENERIC_AI_TRANSLATE_ENDPOINT=https://api.example.com/translate
GENERIC_AI_API_KEY=tu_api_key
